bash-5.3$ # Your cluster's OIDC issuer (EKS publishes the ServiceAccount signing keys here)
export OIDC_ISSUER=$(aws eks describe-cluster --name $CLUSTER --region $AWS_REGION \
  --query cluster.identity.oidc.issuer --output text)
export OIDC_ID=${OIDC_ISSUER##*/}
echo $OIDC_ISSUER     # expect …/id/EXAMPLE0000000000000000000000000

# The On-call pod's ServiceAccount, and confirm its token is mounted
P=$(kubectl -n kagent get pods -o name | grep -i platformoncall | head -1)
export ONCALL_SA=$(kubectl -n kagent get $P -o jsonpath='{.spec.serviceAccountName}')
echo "oncall SA: $ONCALL_SA"
kubectl -n kagent exec $P -- ls /var/run/secrets/kubernetes.io/serviceaccount/token

# A caller identity for alarms and tests
kubectl create namespace ops-callers
kubectl -n ops-callers create serviceaccount incident-intake
