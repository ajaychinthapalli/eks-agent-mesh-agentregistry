bash-5.3$ cat <<EOF | kubectl apply -f -
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayBackend
metadata:
  name: eks-oidc-jwks
  namespace: agentgateway-system
spec:
  static:
    host: oidc.eks.$AWS_REGION.amazonaws.com
    port: 443
  policies:
    tls:
      sni: oidc.eks.$AWS_REGION.amazonaws.com
---
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayPolicy
metadata:
  name: a2a-jwt
  namespace: agentgateway-system
spec:
  targetRefs:
    - { group: gateway.networking.k8s.io, kind: HTTPRoute, name: a2a-eks-troubleshooter }
    - { group: gateway.networking.k8s.io, kind: HTTPRoute, name: a2a-platform-oncall }
  traffic:
    jwtAuthentication:
      mode: Strict
      providers:
        - issuer: "$OIDC_ISSUER"
          jwks:
            remote:
              jwksPath: "/id/$OIDC_ID/keys"
              cacheDuration: "5m"
              backendRef:
                group: agentgateway.dev
                kind: AgentgatewayBackend
                name: eks-oidc-jwks
                port: 443
---
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayPolicy
metadata:
  name: authz-eks-troubleshooter
  namespace: agentgateway-system
spec:
  targetRefs:
    - { group: gateway.networking.k8s.io, kind: HTTPRoute, name: a2a-eks-troubleshooter }
  traffic:
    authorization:
      action: Allow
      policy:
        matchExpressions:
          - "jwt.sub == 'system:serviceaccount:kagent:$ONCALL_SA'"
---
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayPolicy
metadata:
  name: authz-platform-oncall
  namespace: agentgateway-system
spec:
  targetRefs:
    - { group: gateway.networking.k8s.io, kind: HTTPRoute, name: a2a-platform-oncall }
  traffic:
    authorization:
      action: Allow
      policy:
        matchExpressions:
          - "jwt.sub == 'system:serviceaccount:ops-callers:incident-intake'"
EOF

kubectl -n agentgateway-system get agentgatewaypolicy \
