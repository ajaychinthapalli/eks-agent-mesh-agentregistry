bash-5.3$ # 1. No token -> 401
curl -s -o /dev/null -w 'no token: %{http_code}\n' localhost:8080/a2a/ops/ekstroubleshooter/ \
  -H content-type:application/json -d '{}'

# 2. Valid token, wrong caller (incident-intake calling the Troubleshooter directly) -> 403
TOKEN=$(kubectl -n ops-callers create token incident-intake --duration 1h)
curl -s -o /dev/null -w 'wrong caller: %{http_code}\n' localhost:8080/a2a/ops/ekstroubleshooter/ \
  -H "Authorization: Bearer $TOKEN" -H content-type:application/json -d '{}'

# 3. No token to the On-call route -> 401
curl -s -o /dev/null -w 'oncall no token: %{http_code}\n' localhost:8080/a2a/ops/platformoncall/ \
  -H content-type:application/json -d '{}'

# 4. Authorized end-to-end: incident-intake -> On-call -> (its own SA token) -> Troubleshooter
curl -s --max-time 300 localhost:8080/a2a/ops/platformoncall/ \
  -H "Authorization: Bearer $TOKEN" -H content-type:application/json -d '{
  "jsonrpc": "2.0", "id": "inc-4", "method": "message/send",
  "params": {"message": {"role": "user", "kind": "message", "messageId": "inc-4",
    "parts": [{"kind": "text", "text": "Alarm: checkout pods in namespace shop are in CrashLoopBackOff. Root cause?"}]}}
}' | jq -r '.result.artifacts[]?.parts[]?.text // .result.status.message.parts[]?.text // .' | head -15
